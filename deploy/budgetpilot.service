[Unit]
Description=BudgetPilot web dashboard
After=network.target

[Service]
Type=simple
User=budgetpilot
Group=budgetpilot
WorkingDirectory=/var/lib/budgetpilot
EnvironmentFile=-/etc/budgetpilot/budgetpilot.env
Environment=BUDGETPILOT_HOME=/var/lib/budgetpilot
Environment=BUDGETPILOT_HOST=127.0.0.1
Environment=BUDGETPILOT_PORT=8765
# --workers 1 stays the default. Read-modify-write cycles are now
# serialized by json_store.data_lock() (thread lock + flock), so more
# workers no longer silently drop updates, but a single worker is still
# plenty for one household and keeps the lock uncontended.
# See docs/DOCKER.md and docs/ARCHITECTURE.md.
ExecStart=/opt/budgetpilot/.venv/bin/gunicorn --chdir /opt/budgetpilot --bind ${BUDGETPILOT_HOST}:${BUDGETPILOT_PORT} --workers 1 --timeout 60 budgetpilot_web:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/budgetpilot
UMask=0077

[Install]
WantedBy=multi-user.target
